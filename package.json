{
  "name": "skill-manager",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "files": [
    "build/server",
    "dist",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node build/server/index.js",
    "test": "vitest run",
    "format:check": "prettier --check server src tests scripts package.json tsconfig.json tsconfig.server.json"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.7",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
